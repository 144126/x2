{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "x2",
	"compatibility_date": "2026-07-18",
	"compatibility_flags": ["nodejs_compat_v2"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"secrets_store_secrets": [
		{
			"binding": "QDRANT_URL",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "QDRANT_URL"
		},
		{
			"binding": "QDRANT_KEY",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "QDRANT_KEY"
		},
		{
			"binding": "VOXELL_KEY",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "VOXELL_KEY"
		},
		{
			"binding": "SECRET",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "SECRET"
		},
		{
			"binding": "GOOGLE_ID",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "GOOGLE_ID"
		},
		{
			"binding": "GOOGLE_SECRET",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "GOOGLE_SECRET"
		},
		// same slots as ../beee — populate with `wrangler secrets-store secret create` before deploying
		{
			"binding": "PAYSTACK_SECRET_KEY_TEST",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "PAYSTACK_SECRET_KEY_TEST"
		},
		{
			"binding": "PAYSTACK_SECRET_KEY_LIVE",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "PAYSTACK_SECRET_KEY_LIVE"
		},
		{
			"binding": "PAYSTACK_TEST",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "PAYSTACK_TEST"
		},
		{ "binding": "TURN_KEY_ID", "store_id": "45748cb1c67946df943075fa14cb8815", "secret_name": "TURN_KEY_ID" },
		{
			"binding": "TURN_KEY_API_TOKEN",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "TURN_KEY_API_TOKEN"
		},
		{
			"binding": "VAPID_PUBLIC",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "VAPID_PUBLIC"
		},
		{
			"binding": "VAPID_PRIVATE",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "VAPID_PRIVATE"
		},
		{
			"binding": "VAPID_SUBJECT",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "VAPID_SUBJECT"
		}
	],
	// WS_ORIGIN: the deployed x2-ws worker's public origin. Committed here (not left blank and
	// patched via dashboard) because `wrangler deploy` overwrites dashboard-set vars with
	// whatever wrangler.jsonc says on every deploy — a blank value here silently re-breaks
	// realtime delivery (client never opens a websocket, /api/wstoken 503s) on the next push.
	// Local dev falls back to ws://localhost:8787 (see ws/wrangler.jsonc dev port) when unset.
	"vars": { "WS_ORIGIN": "wss://x2-ws.apexlinks.workers.dev" },
	"services": [{ "binding": "X2_WS", "service": "x2-ws" }],
	// per-user quotas on paid/heavy endpoints — keyed on uid in src/lib/server/rl.ts, never IP
	// (everything below is authenticated, and IP buckets punish shared NAT). period is Cloudflare's
	// enum: exactly 10 or 60 seconds, nothing else validates.
	"ratelimits": [
		{ "name": "RL_SEND", "namespace_id": "1001", "simple": { "limit": 30, "period": 10 } },
		{ "name": "RL_UPLOAD", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RL_SEARCH", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RL_AI", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } }
	],
	// chat image uploads; create once with: wrangler r2 bucket create x2-media
	// `remote: true` keeps the Worker local in dev while proxying this binding to the real
	// bucket — otherwise dev writes into Miniflare's on-disk emulation and nothing ever
	// reaches x2-media. `wrangler dev` honors this automatically for any binding so marked;
	// no extra CLI flag or script needed — `pnpm dev:full` (or `dev:ws`) already gets it.
	// Plain `pnpm dev` (bare `vite dev`, no wrangler) never touches R2 at all, live or local.
	// NOT verified end-to-end here: the CLOUDFLARE_API_TOKEN in this environment lacks R2
	// read permission, so `wrangler r2 object get` couldn't confirm an upload actually lands
	// in the real bucket. Config validated via `wrangler deploy --dry-run` (accepted with
	// zero warnings) — `remote` is this wrangler version's schema-supported field name (see
	// node_modules/wrangler/config-schema.json), not the older `experimental_remote`, which
	// this binary (4.114.0) rejects outright with "Unexpected fields found in r2_buckets[0]".
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "x2-media", "remote": true }],
	"workers_dev": true,
	"preview_urls": true,
	"observability": { "enabled": true, "head_sampling_rate": 0.01 }
}
