{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "x2-ws",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-18",
	"compatibility_flags": ["nodejs_compat_v2"],
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_HUB", "class_name": "ChatHub" },
			{ "name": "CREDIT_ACCOUNT", "class_name": "CreditAccount" },
			{ "name": "ROOM", "class_name": "Room" },
			{ "name": "MATCH_LOBBY", "class_name": "MatchLobby" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ChatHub"] },
		{ "tag": "v2", "new_sqlite_classes": ["MatchLobby"] },
		{ "tag": "v3", "new_sqlite_classes": ["CreditAccount"] },
		// dropping a DO class without a deleted_classes migration fails the deploy
		{ "tag": "v4", "deleted_classes": ["MatchLobby"] },
		{ "tag": "v5", "new_sqlite_classes": ["Room"] },
		// the random voice match is back, so the class has to be re-created
		{ "tag": "v6", "new_sqlite_classes": ["MatchLobby"] }
	],
	"dev": { "port": 8787 },
	"triggers": { "crons": ["*/1 * * * *"] },
	// SECRET must be the SAME store_id+secret_name x2's wrangler.jsonc uses — this is what
	// signs/verifies ws tokens across the two workers. It was previously a blank plain `vars`
	// entry, which `wrangler deploy` used to silently stomp a dashboard-set value with "" on
	// every push (same failure mode WS_ORIGIN had) — every websocket handshake got a 403.
	// X2_ORIGIN (the deployed x2 worker's public origin, for the cron callback) is bound the
	// same way for the same reason — a plain blank var gets silently reset on every deploy.
	"secrets_store_secrets": [
		{
			"binding": "QDRANT_URL",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "QDRANT_URL"
		},
		{
			"binding": "QDRANT_KEY",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "QDRANT_KEY"
		},
		{
			"binding": "SECRET",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "SECRET"
		},
		{
			"binding": "X2_ORIGIN",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "X2_ORIGIN"
		},
		// hub_owns_delivery: ChatHub sends web push itself now, so it needs the same VAPID
		// keys x2's wrangler.jsonc already declares — same store_id/secret_name, populate with
		// `wrangler secrets-store secret create` before deploying if not already present.
		{
			"binding": "VAPID_PUBLIC",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "VAPID_PUBLIC"
		},
		{
			"binding": "VAPID_PRIVATE",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "VAPID_PRIVATE"
		},
		{
			"binding": "VAPID_SUBJECT",
			"store_id": "45748cb1c67946df943075fa14cb8815",
			"secret_name": "VAPID_SUBJECT"
		}
	],
	"workers_dev": true,
	"preview_urls": true,
	"observability": { "enabled": true, "head_sampling_rate": 1 }
}
