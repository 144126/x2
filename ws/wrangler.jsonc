{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "x2-ws",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-18",
	"compatibility_flags": ["nodejs_compat_v2"],
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_HUB", "class_name": "ChatHub" },
			{ "name": "MATCH_LOBBY", "class_name": "MatchLobby" },
			{ "name": "CREDIT_ACCOUNT", "class_name": "CreditAccount" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ChatHub"] },
		{ "tag": "v2", "new_sqlite_classes": ["MatchLobby"] },
		{ "tag": "v3", "new_sqlite_classes": ["CreditAccount"] }
	],
	"dev": { "port": 8787 },
	"triggers": { "crons": ["*/1 * * * *"] },
	// X2_ORIGIN: the deployed x2 (main) worker's public origin — set before deploying so the
	// cron can reach POST /api/cron/dispatch-scheduled.
	"vars": { "SECRET": "", "X2_ORIGIN": "" },
	"secrets_store_secrets": [
		{ "binding": "QDRANT_URL", "store_id": "45748cb1c67946df943075fa14cb8815", "secret_name": "QDRANT_URL" },
		{ "binding": "QDRANT_KEY", "store_id": "45748cb1c67946df943075fa14cb8815", "secret_name": "QDRANT_KEY" }
	],
	"workers_dev": true,
	"preview_urls": true,
	"observability": { "enabled": true, "head_sampling_rate": 1 }
}
